{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/openspec-auto-commit.js",
            "if": "Bash(openspec validate*)",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Comprobando si hay que auto-commitear el cambio de OpenSpec..."
          }
        ]
      }
    ]
  }
}
